<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="24dp"
    android:paddingBottom="20dp">

    <TextView
        android:letterSpacing="-0.02"
        android:textColor="@color/stride_text"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/TextProfileTitle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/profilePhoto"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:contentDescription="@string/TextProfilePhotoDescription"
            android:src="@drawable/bg_avatar" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/profileName"
                android:textColor="@color/stride_text"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="Jeremy" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/profileEmail"
                android:textColor="@color/stride_muted"
                android:textSize="13sp"
                tools:text="jere@gmail.com" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:background="@drawable/bg_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical"
        android:paddingHorizontal="16dp">
            <LinearLayout
                android:id="@+id/editProfileRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="14dp">
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_pen"
                    android:tint="@color/stride_accent_light" />
                <TextView
                    android:layout_height="wrap_content"
                    android:textColor="@color/stride_text"
                    android:layout_width="0dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/TextProfileEdit"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/stride_muted" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/stride_line" />
            <LinearLayout
                android:id="@+id/languageRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="14dp">
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_globe"
                    android:tint="@color/stride_accent_light" />
                <TextView
                    android:layout_height="wrap_content"
                    android:textColor="@color/stride_text"
                    android:layout_width="0dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/TextProfileLanguage"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/stride_muted"
                    android:textSize="13sp"
                    android:text="@string/TextProfileLanguageValue"
                    android:textStyle="bold" />
            </LinearLayout>
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/logoutButton"
        android:background="@drawable/bg_button_ghost"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="52dp"
        android:textSize="15sp"
        android:textStyle="bold"
        android:layout_marginBottom="14dp"
        android:drawableStart="@drawable/ic_logout"
        android:drawablePadding="8dp"
        android:drawableTint="@color/stride_danger"
        android:paddingHorizontal="24dp"
        android:text="@string/TextProfileLogout"
        android:textColor="@color/stride_danger" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_nav_pill"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="10dp">

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

        <FrameLayout
            android:id="@+id/navHome"
            android:layout_width="44dp"
            android:layout_height="36dp"
            android:contentDescription="@string/TextNavHome">
            <ImageView
                android:id="@+id/navHomeIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_home"
                android:tint="@color/stride_accent_light" />
        </FrameLayout>

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

        <FrameLayout
            android:id="@+id/navMap"
            android:layout_width="44dp"
            android:layout_height="36dp"
            android:contentDescription="@string/TextNavMap">
            <ImageView
                android:id="@+id/navMapIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_map"
                android:tint="@color/stride_accent_light" />
        </FrameLayout>

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

        <FrameLayout
            android:id="@+id/navProfile"
            android:layout_width="44dp"
            android:layout_height="36dp"
            android:contentDescription="@string/TextNavProfile">
            <ImageView
                android:id="@+id/navProfileImage"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:src="@drawable/bg_avatar_small" />
        </FrameLayout>

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
    </LinearLayout>
</LinearLayout>
