<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="24dp"
    android:paddingBottom="20dp">

    <TextView
        android:letterSpacing="-0.02"
        android:textColor="@color/stride_text"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/TextMapTitle" />
    <TextView
        android:textColor="@color/stride_muted"
        android:textSize="13sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/TextMapSubtitle" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="14dp"
        android:layout_weight="1"
        android:background="@drawable/bg_map_card"
        android:clipToOutline="true">

        <FrameLayout
            android:id="@+id/mapContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/stride_surface">

            <View
                android:layout_width="700dp"
                android:layout_height="14dp"
                android:layout_marginStart="-100dp"
                android:layout_marginTop="150dp"
                android:background="@drawable/bg_road"
                android:rotation="-18" />
            <View
                android:layout_width="12dp"
                android:layout_height="700dp"
                android:layout_marginStart="220dp"
                android:layout_marginTop="-100dp"
                android:background="@drawable/bg_road"
                android:rotation="8" />
            <View
                android:layout_width="700dp"
                android:layout_height="9dp"
                android:layout_marginStart="-100dp"
                android:layout_marginTop="330dp"
                android:background="@drawable/bg_road"
                android:rotation="6" />
            <View
                android:layout_width="90dp"
                android:layout_height="70dp"
                android:layout_marginStart="24dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_park" />
            <View
                android:layout_width="80dp"
                android:layout_height="60dp"
                android:layout_marginStart="230dp"
                android:layout_marginTop="260dp"
                android:background="@drawable/bg_park" />
        </FrameLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/pinLayer"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/pinExercise"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_pin_gradient"
                android:contentDescription="@string/TextMapPinDescription"
                android:padding="11dp"
                android:src="@drawable/ic_activity"
                android:tint="@color/stride_on_accent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.40"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.34" />
            <ImageView
                android:id="@+id/pinReading"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_pin_gold"
                android:contentDescription="@string/TextMapPinDescription"
                android:padding="8dp"
                android:src="@drawable/ic_book"
                android:tint="@color/stride_on_accent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.16"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.15" />
            <ImageView
                android:id="@+id/pinMeditate"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_pin_cyan"
                android:contentDescription="@string/TextMapPinDescription"
                android:padding="8dp"
                android:src="@drawable/ic_sun"
                android:tint="@color/stride_on_accent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.72"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.22" />
            <ImageView
                android:id="@+id/pinWater"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_pin_green"
                android:contentDescription="@string/TextMapPinDescription"
                android:padding="8dp"
                android:src="@drawable/ic_drop"
                android:tint="@color/stride_on_accent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.20"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.60" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <ImageView
            android:id="@+id/myLocationButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="top|end"
            android:layout_margin="10dp"
            android:background="@drawable/bg_circle_button"
            android:contentDescription="@string/TextMyLocationDescription"
            android:padding="9dp"
            android:src="@drawable/ic_target"
            android:tint="@color/stride_accent_light" />

        <LinearLayout
            android:id="@+id/pinInfoCard"
            android:background="@drawable/bg_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_margin="10dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">
            <ImageView
                android:id="@+id/pinInfoIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_tile"
                android:importantForAccessibility="no"
                android:padding="9dp"
                android:src="@drawable/ic_activity"
                android:tint="@color/stride_accent_light" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/pinInfoName"
                    android:textColor="@color/stride_text"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="Central Gym" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/pinInfoDetail"
                    android:textColor="@color/stride_muted"
                    android:textSize="11.5sp"
                    tools:text="Exercise · 14 times" />
            </LinearLayout>
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron_right"
                android:tint="@color/stride_muted" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_nav_pill"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="10dp">

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

        <FrameLayout
            android:id="@+id/navHome"
            android:layout_width="44dp"
            android:layout_height="36dp"
            android:contentDescription="@string/TextNavHome">
            <ImageView
                android:id="@+id/navHomeIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_home"
                android:tint="@color/stride_accent_light" />
        </FrameLayout>

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

        <FrameLayout
            android:id="@+id/navMap"
            android:layout_width="44dp"
            android:layout_height="36dp"
            android:contentDescription="@string/TextNavMap">
            <ImageView
                android:id="@+id/navMapIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_map"
                android:tint="@color/stride_accent_light" />
        </FrameLayout>

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

        <FrameLayout
            android:id="@+id/navProfile"
            android:layout_width="44dp"
            android:layout_height="36dp"
            android:contentDescription="@string/TextNavProfile">
            <ImageView
                android:id="@+id/navProfileImage"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:src="@drawable/bg_avatar_small" />
        </FrameLayout>

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
    </LinearLayout>
</LinearLayout>
