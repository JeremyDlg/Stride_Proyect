<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="0dp"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/app_name"
            android:textColor="@color/stride_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:letterSpacing="-0.02"
            android:textColor="@color/stride_text"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="@string/TextTagline" />
        <TextView
            android:textColor="@color/stride_muted"
            android:textSize="13sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/TextLoginSubtitle" />

        <TextView
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp"
            android:textColor="@color/stride_muted"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/TextName" />
        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/nameInput"
            android:background="@drawable/bg_input"
            android:maxLines="1"
            android:paddingBottom="14dp"
            android:paddingEnd="16dp"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:textColor="@color/stride_text"
            android:textColorHint="@color/stride_muted"
            android:textSize="15sp"
            android:autofillHints="name"
            android:hint="@string/TextNameHint"
            android:inputType="textPersonName" />

        <TextView
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp"
            android:textColor="@color/stride_muted"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/TextEmail" />
        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/emailInput"
            android:background="@drawable/bg_input"
            android:maxLines="1"
            android:paddingBottom="14dp"
            android:paddingEnd="16dp"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:textColor="@color/stride_text"
            android:textColorHint="@color/stride_muted"
            android:textSize="15sp"
            android:autofillHints="emailAddress"
            android:hint="@string/TextEmailHint"
            android:inputType="textEmailAddress" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:textColor="@color/stride_muted"
            android:textSize="11.5sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/TextLoginPrivacyNote" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/continueButton"
            android:background="@drawable/bg_button_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="52dp"
            android:textColor="@color/stride_on_accent"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            android:text="@string/TextContinue" />
    </LinearLayout>
</ScrollView>
