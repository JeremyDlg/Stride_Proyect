<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingVertical="22dp">

    <ImageView
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_danger_soft"
        android:importantForAccessibility="no"
        android:padding="14dp"
        android:src="@drawable/ic_trash"
        android:tint="@color/stride_danger" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/stride_text"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="@string/TextDeleteTitle"
        android:textSize="18sp"
        android:textStyle="bold" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/deleteMessage"
        android:textColor="@color/stride_muted"
        android:textSize="13sp"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.15"
        android:text="@string/TextDeleteMessageGeneric" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">
        <TextView
            android:layout_height="wrap_content"
            android:id="@+id/cancelButton"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="52dp"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_soft"
            android:text="@string/TextCancel"
            android:textColor="@color/stride_text" />
        <TextView
            android:layout_height="wrap_content"
            android:id="@+id/confirmButton"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="52dp"
            android:textColor="@color/stride_on_accent"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_width="0dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_danger"
            android:text="@string/TextDelete" />
    </LinearLayout>
</LinearLayout>
