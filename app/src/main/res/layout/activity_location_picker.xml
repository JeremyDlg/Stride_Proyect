<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/cancelButton"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp"
            android:text="@string/TextCancel"
            android:textColor="@color/stride_accent_light"
            android:textSize="14sp"
            android:textStyle="bold" />
        <TextView
            android:layout_height="wrap_content"
            android:textColor="@color/stride_text"
            android:textSize="15sp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/TextLocationTitle"
            android:textStyle="bold" />
        <View android:layout_width="64dp" android:layout_height="1dp" />
    </LinearLayout>

    <EditText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/searchInput"
        android:background="@drawable/bg_input"
        android:inputType="text"
        android:maxLines="1"
        android:paddingBottom="14dp"
        android:paddingEnd="16dp"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:textColor="@color/stride_text"
        android:textColorHint="@color/stride_muted"
        android:textSize="15sp"
        android:layout_marginTop="14dp"
        android:drawableStart="@drawable/ic_search"
        android:drawablePadding="10dp"
        android:drawableTint="@color/stride_muted"
        android:hint="@string/TextLocationSearchHint"
        android:imeOptions="actionSearch" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1"
        android:background="@drawable/bg_map_card"
        android:clipToOutline="true">

        <FrameLayout
            android:id="@+id/mapContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/stride_surface">

            <View
                android:layout_width="700dp"
                android:layout_height="14dp"
                android:layout_marginStart="-100dp"
                android:layout_marginTop="150dp"
                android:background="@drawable/bg_road"
                android:rotation="-18" />
            <View
                android:layout_width="12dp"
                android:layout_height="700dp"
                android:layout_marginStart="220dp"
                android:layout_marginTop="-100dp"
                android:background="@drawable/bg_road"
                android:rotation="8" />
            <View
                android:layout_width="700dp"
                android:layout_height="9dp"
                android:layout_marginStart="-100dp"
                android:layout_marginTop="330dp"
                android:background="@drawable/bg_road"
                android:rotation="6" />
            <View
                android:layout_width="90dp"
                android:layout_height="70dp"
                android:layout_marginStart="24dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_park" />
            <View
                android:layout_width="80dp"
                android:layout_height="60dp"
                android:layout_marginStart="230dp"
                android:layout_marginTop="260dp"
                android:background="@drawable/bg_park" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:paddingBottom="8dp"
            android:paddingEnd="13dp"
            android:paddingStart="13dp"
            android:paddingTop="8dp"
            android:textColor="@color/stride_text"
            android:textStyle="bold"
            android:layout_gravity="top|start"
            android:layout_margin="10dp"
            android:background="@drawable/bg_chip"
            android:text="@string/TextLocationMovePin"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/myLocationButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="top|end"
            android:layout_margin="10dp"
            android:background="@drawable/bg_circle_button"
            android:contentDescription="@string/TextMyLocationDescription"
            android:padding="9dp"
            android:src="@drawable/ic_target"
            android:tint="@color/stride_accent_light" />

        <ImageView
            android:id="@+id/centerPin"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_pin_gradient"
            android:contentDescription="@string/TextMapPinDescription"
            android:padding="11dp"
            android:src="@drawable/ic_pin"
            android:tint="@color/stride_on_accent" />
    </FrameLayout>

    <LinearLayout
        android:background="@drawable/bg_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">
        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_icon_tile"
            android:importantForAccessibility="no"
            android:padding="10dp"
            android:src="@drawable/ic_pin"
            android:tint="@color/stride_accent_light" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <EditText
                android:id="@+id/placeNameInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="@string/TextLocationPlaceNameHint"
                android:inputType="textCapWords"
                android:maxLines="1"
                android:padding="0dp"
                android:textColor="@color/stride_text"
                android:textColorHint="@color/stride_muted"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="La Sabana Park" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/coordinatesText"
                android:textColor="@color/stride_muted"
                android:textSize="11.5sp"
                android:layout_marginTop="2dp"
                tools:text="9.9366, -84.1035" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/saveLocationButton"
        android:background="@drawable/bg_button_primary"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="52dp"
        android:textColor="@color/stride_on_accent"
        android:textSize="15sp"
        android:textStyle="bold"
        android:layout_marginTop="12dp"
        android:text="@string/TextLocationSave" />
</LinearLayout>
